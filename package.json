{
  "name": "litkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:smoke": "tsc -p tools/typecheck-smoke/tsconfig.node16.json && tsc -p tools/typecheck-smoke/tsconfig.bundler.json",
    "doc-check": "npm run build && node tools/doc-check/extract-snippets.mjs && tsc -p tools/doc-check/tsconfig.node16.json && tsc -p tools/doc-check/tsconfig.bundler.json",
    "doc-check:snippets": "node tools/doc-check/extract-snippets.mjs && tsc -p tools/doc-check/tsconfig.node16.json && tsc -p tools/doc-check/tsconfig.bundler.json",
    "test": "npm run test --workspaces --if-present",
    "coverage": "vitest run --coverage",
    "changeset:status": "changeset status",
    "dev:kit": "npm run dev -w @willramdev/kit",
    "dev:router": "npm run dev -w @willramdev/router",
    "dev:query": "npm run dev -w @willramdev/query",
    "dev:forms": "npm run dev -w @willramdev/forms",
    "dev:store": "npm run dev -w @willramdev/store"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "publint": "^0.3.23"
  }
}
