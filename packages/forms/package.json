{
  "name": "@willramdev/forms",
  "version": "1.1.0",
  "description": "Type-safe form management for Lit with validation, binding, and array fields",
  "keywords": [
    "lit",
    "forms",
    "web-components",
    "validation",
    "reactive-controller"
  ],
  "license": "MIT",
  "author": "William Ramanand",
  "repository": {
    "type": "git",
    "url": "https://github.com/willramdev/litkit.git",
    "directory": "packages/forms"
  },
  "type": "module",
  "sideEffects": [
    "dist/forms.js"
  ],
  "main": "./dist/forms.js",
  "module": "./dist/forms.js",
  "types": "./dist/index.d.ts",
  "customElements": "./custom-elements.json",
  "web-types": "./web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/forms.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "custom-elements.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json",
    "web-types.json"
  ],
  "scripts": {
    "dev": "vite demo",
    "cem": "cem analyze && node ../../tools/cem-check/normalize-cem-eol.mjs .",
    "build": "vite build && tsc -p tsconfig.build.json && npm run cem",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@tanstack/form-core": "^1.0.0",
    "lit": "^3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@tanstack/form-core": "^1.28.5",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "lit": "^3.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.9",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
