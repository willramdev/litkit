{
  "name": "@willram/forms",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/forms.js",
  "module": "./dist/forms.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/forms.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/form-core": "^1.28.5"
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "lit": "^3.3.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "zod": "^4.3.6"
  }
}
