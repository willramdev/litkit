{
  "name": "@willram/forms",
  "version": "1.0.0",
  "description": "Type-safe form management for Lit with validation, binding, and array fields",
  "keywords": [
    "lit",
    "forms",
    "web-components",
    "validation",
    "reactive-controller"
  ],
  "license": "MIT",
  "author": "William Ramanand",
  "repository": {
    "type": "git",
    "url": "https://github.com/willram/litkit.git",
    "directory": "packages/forms"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/forms.js",
  "module": "./dist/forms.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/forms.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/form-core": "^1.28.5"
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "lit": "^3.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.9",
    "zod": "^4.3.6"
  }
}
