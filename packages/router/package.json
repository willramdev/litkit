{
  "name": "@willram/router",
  "version": "1.0.0",
  "description": "Client-side router for Lit with guards, lazy loading, nested routes, and scroll management",
  "keywords": ["lit", "router", "web-components", "spa", "client-side-routing"],
  "license": "MIT",
  "author": "William Ramanand",
  "repository": {
    "type": "git",
    "url": "https://github.com/willram/litkit.git",
    "directory": "packages/router"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/router.cjs",
  "module": "./dist/router.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/router.js",
      "require": "./dist/router.cjs"
    },
    "./core": {
      "types": "./dist/router-core/index.d.ts",
      "import": "./dist/router-core.js",
      "require": "./dist/router-core.cjs"
    },
    "./lit": {
      "types": "./dist/router-lit/index.d.ts",
      "import": "./dist/router-lit.js",
      "require": "./dist/router-lit.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.0.1",
    "lit": "^3.3.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
