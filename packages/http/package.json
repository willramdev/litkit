{
  "name": "@willramdev/http",
  "version": "1.2.0",
  "description": "A fetch-based HTTP client with interceptors, timeouts, retries, schema validation, and typed errors. JavaScript-first, fully typed, framework-neutral",
  "keywords": [
    "http",
    "fetch",
    "http-client",
    "interceptors",
    "retry",
    "standard-schema"
  ],
  "license": "MIT",
  "author": "William Ramanand",
  "repository": {
    "type": "git",
    "url": "https://github.com/willramdev/litkit.git",
    "directory": "packages/http"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/http.js",
  "module": "./dist/http.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "jsdom": "^29.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.9",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
