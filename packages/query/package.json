{
  "name": "@willramdev/query",
  "version": "1.1.0",
  "description": "Lit controllers for TanStack Query — reactive data fetching and mutations",
  "keywords": [
    "lit",
    "tanstack-query",
    "web-components",
    "reactive-controller",
    "data-fetching"
  ],
  "license": "MIT",
  "author": "William Ramanand",
  "repository": {
    "type": "git",
    "url": "https://github.com/willramdev/litkit.git",
    "directory": "packages/query"
  },
  "type": "module",
  "sideEffects": [
    "dist/query.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "custom-elements.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json",
    "web-types.json"
  ],
  "main": "./dist/query.js",
  "module": "./dist/query.js",
  "types": "./dist/index.d.ts",
  "customElements": "./custom-elements.json",
  "web-types": "./web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/query.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "cem": "cem analyze && node ../../tools/cem-check/normalize-cem-eol.mjs .",
    "build": "vite build && tsc -p tsconfig.build.json && npm run cem",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@tanstack/query-core": "^5.91.0",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "lit": "^3.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
